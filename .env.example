PORT=3400
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
GEMINI_API_KEY=

# Optional reverse proxy / Cloudflare Tunnel public hostname (e.g. trade.example.com)
PUBLIC_DOMAIN=
# Required (>= 16 chars) when PUBLIC_DOMAIN is set or accessing /api/auth/session over a tunnel/proxy
OPERATOR_ACCESS_PIN=
# Required (>= 16 chars) to enable POST /api/webhook TradingView alert ingestion
WEBHOOK_SECRET=

# Optional Telegram alerting for trade lifecycle and critical risk/exchange events
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
